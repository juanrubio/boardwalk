# README showcase (read-only): open a board, navigate, peek at detail,
# toggle density, cycle to the next board and back, open the board
# picker and help. Safe against a real board — nothing mutates.
Output ../docs/media/showcase.gif
Set Width 1280
Set Height 760
Set FontSize 15
Type "boardwalk board --project juanrubio/1"
Enter
Sleep 4s
Type "j"
Sleep 700ms
Type "j"
Sleep 700ms
Type "l"
Sleep 900ms
Enter
Sleep 2s
Escape
Sleep 800ms
Type "d"
Sleep 1200ms
Type "d"
Sleep 900ms
Type "]"
Sleep 3s
Type "["
Sleep 3s
Type "P"
Sleep 1500ms
Escape
Sleep 800ms
Type "?"
Sleep 1800ms
Escape
Sleep 600ms
Type "q"
Sleep 1s
